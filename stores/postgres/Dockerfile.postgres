# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/app ./stores/postgres/cmd

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/app /usr/local/bin/store-postgres
USER nonroot
EXPOSE 9101 9111 9121
ENTRYPOINT ["/usr/local/bin/store-postgres"]
