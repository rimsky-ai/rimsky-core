# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS builder
WORKDIR /build
# Post-2026-05-12 layer restructure: foundation and protocols are
# separate Go modules tied together by go.work. Copy all module
# manifests + the workspace file before `go mod download`.
COPY go.work go.work.sum ./
COPY go.mod go.sum ./
COPY foundation/go.mod foundation/go.sum ./foundation/
COPY protocols/go.mod protocols/go.sum ./protocols/
COPY testpg/go.mod testpg/go.sum ./testpg/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/app ./executors/stub/cmd

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/app /usr/local/bin/executor-stub
USER nonroot
EXPOSE 9300
ENTRYPOINT ["/usr/local/bin/executor-stub"]
