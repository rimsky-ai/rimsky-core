# Crimefinder service registrations. Consumer merges into their rimsky.yml.
executors:
  crimefinder:
    transport: grpc
    endpoint: "host.docker.internal:7071"
    tls: off
    protocols: [executor]

claim_producers:
  crimefinder:
    endpoint: "grpc://crimefinder-producer:9100"
    protocols: [claim_producer]
    write_semantics_allowed: [sync]
