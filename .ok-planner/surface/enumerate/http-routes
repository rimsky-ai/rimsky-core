#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../../.."

verb_path() { sed -E 's/^\.([A-Za-z]+)\("(.*)"$/\1 \2/'; }

emit() {
  local listener="$1" prefix="$2"; shift 2
  git grep -h -o -E '\.(Get|Post|Put|Patch|Delete)\("/[^"]*"' -- "$@" ':!*_test.go' \
    | verb_path | awk -v l="$listener" -v p="$prefix" '{ print $1 " " l " " p $2 }'
}

{
  emit control-api /v1 'lib/control/controlapi/'
  emit control-api /v1/observability 'lib/control/observability/'

  git grep -h -o -E '\.Method\("(GET|POST|PUT|PATCH|DELETE)", "/[^"]*"' -- \
    'lib/control/' ':!*_test.go' \
    | sed -E 's/^\.Method\("([A-Z]+)", "(.*)"$/\1 \2/' \
    | awk '{ m = toupper(substr($1,1,1)) tolower(substr($1,2)); print m " control-api /v1" $2 }'

  emit supervisor-callback "" 'lib/runtime/callback.go'
  emit sensor-webhook "" 'lib/services/sensors/sensor-webhook/'
} | sort -u
