{
  "name": "fs-inplace-write",
  "version": "v1",
  "nodes": [
    {
      "type": "writer",
      "executor": "http-node",
      "claim_producers": [
        {
          "name": "claim-producer-filesystem",
          "selector": "data/reports",
          "intent": "rw",
          "alias": "held"
        }
      ],
      "error_types": {
        "acquire/unavailable": {
          "action": "give_up"
        }
      },
      "attributes": {
        "schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "default": "http://host.docker.internal:19429/write"
            },
            "method": {
              "type": "string",
              "default": "POST"
            },
            "held_addr": {
              "type": "string",
              "source": "{{claim.held.address}}"
            },
            "filename": {
              "type": "string",
              "default": "out.txt"
            },
            "content": {
              "type": "string",
              "default": "written-in-place"
            }
          }
        }
      }
    }
  ]
}
