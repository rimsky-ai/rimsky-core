FROM node:20-alpine AS builder
WORKDIR /build
COPY executors/claude-agent/package.json executors/claude-agent/package-lock.json* ./
RUN npm ci || npm install
COPY executors/claude-agent/ ./
RUN npm run build
COPY protocols/proto/v1/ /build/protocols/proto/v1/

FROM node:20-alpine
RUN apk add --no-cache tini
WORKDIR /app
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/protocols ./protocols
ENV NODE_ENV=production
USER node
EXPOSE 9090 9190
ENTRYPOINT ["/sbin/tini", "--", "node", "dist/main.js"]
