# syntax=docker/dockerfile:1.7
#
# Multi-stage build of the `rimsky` image. Bundles all four role binaries
# (scheduler, supervisor, control-api, migrate) plus rimsky-entrypoint under
# a single PID-1 entrypoint. rimsky-entrypoint reads its command argument: with
# NO command it runs all three roles (scheduler + supervisor + control-api)
# in-process — the single-process all-in-one stack; with a single role argument
# (`rimsky-scheduler` | `rimsky-supervisor` | `rimsky-control-api`) it spawns
# ONLY that role, for one-role-per-container deploys; an unknown argument exits
# non-zero. Migrate runs synchronously before the roles start when the invocation
# owns it (the no-command path always; a single-role container only for
# rimsky-control-api, or as forced/skipped by RIMSKY_ENTRYPOINT_MIGRATE=1/0).
# The persistence backend (postgres|sqlite) is selected by config; defaults to
# sqlite with state at /var/lib/rimsky/state.db (development only — use the
# postgres driver for deployed instances).

FROM golang:1.25-alpine AS build
WORKDIR /src
# The Go workspace ties four modules together (root + lib/foundation
# + lib/protocols + lib/services). Copy every module manifest plus
# go.work before `go mod download` so the build sees the same module
# graph as the host workspace. The core binaries built here don't
# import lib/services, but go.work lists it so its go.mod must be
# present or `go mod download` aborts.
COPY go.work go.work.sum ./
COPY go.mod go.sum ./
COPY lib/foundation/go.mod lib/foundation/go.sum ./lib/foundation/
COPY lib/protocols/go.mod lib/protocols/go.sum ./lib/protocols/
COPY lib/services/go.mod lib/services/go.sum ./lib/services/
# go.work lists ./examples, so its go.mod/go.sum must be present or
# `go mod download` aborts loading the workspace.
COPY examples/go.mod examples/go.sum ./examples/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky-scheduler   ./cmd/rimsky-scheduler && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky-supervisor  ./cmd/rimsky-supervisor && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky-control-api ./cmd/rimsky-control-api && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky-migrate     ./cmd/rimsky-migrate && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky-entrypoint  ./cmd/rimsky-entrypoint && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/rimsky             ./cmd/rimsky

# Stage an empty /var/lib/rimsky directory we can COPY into the
# distroless final stage with explicit nonroot ownership. Without this,
# Docker auto-creates the VOLUME mount point as root and the nonroot
# user can't write to it (sqlite: ping: unable to open database file).
RUN mkdir -p /staging/var/lib/rimsky && chown -R 65532:65532 /staging/var/lib/rimsky

FROM gcr.io/distroless/static-debian12:nonroot
LABEL org.opencontainers.image.title="rimsky"
LABEL org.opencontainers.image.description="rimsky orchestrator — all role binaries under one image; no command runs all three roles in one process, a single role argument spawns only that role; backend (postgres|sqlite) by config. Defaults to SQLite (development only)."

COPY --from=build /out/rimsky-scheduler   /usr/local/bin/rimsky-scheduler
COPY --from=build /out/rimsky-supervisor  /usr/local/bin/rimsky-supervisor
COPY --from=build /out/rimsky-control-api /usr/local/bin/rimsky-control-api
COPY --from=build /out/rimsky-migrate     /usr/local/bin/rimsky-migrate
COPY --from=build /out/rimsky-entrypoint  /usr/local/bin/rimsky-entrypoint
COPY --from=build /out/rimsky             /usr/local/bin/rimsky
# Config (rimsky.yml + supervisor-config.yml) is mounted at runtime, not
# baked into the image. Deploy tooling mounts them at the RIMSKY_CONFIG /
# RIMSKY_SUPERVISOR_CONFIG paths set below.
COPY --from=build --chown=nonroot:nonroot /staging/var/lib/rimsky /var/lib/rimsky

USER nonroot:nonroot
EXPOSE 8080
VOLUME /var/lib/rimsky
ENV RIMSKY_CONFIG=/etc/rimsky/rimsky.yml \
    RIMSKY_SUPERVISOR_CONFIG=/etc/rimsky/supervisor-config.yml

ENTRYPOINT ["/usr/local/bin/rimsky-entrypoint"]
