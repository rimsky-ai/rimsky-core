# syntax=docker/dockerfile:1.7
#
# Multi-stage build of the `rimsky-conformance` image. Bundles every
# protocol conformance runner in one image; select a runner via
# `rimsky conformance <protocol>`, e.g.:
#   docker run rimsky-conformance rimsky conformance executor \
#     --endpoint <addr> --transport grpc
# The runners probe an EXTERNAL impl (executor / claim-producer / publisher /
# validation / data-processing / lifecycle-subscriber / host-daemon)
# against the rimsky protocol.

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
# The Go workspace ties four modules together (root + lib/foundation
# + lib/protocols + lib/services). Copy every module manifest plus
# go.work before `go mod download` so the build sees the same module
# graph as the host workspace.
COPY go.work go.work.sum ./
COPY go.mod go.sum ./
COPY lib/foundation/go.mod lib/foundation/go.sum ./lib/foundation/
COPY lib/protocols/go.mod lib/protocols/go.sum ./lib/protocols/
COPY lib/services/go.mod lib/services/go.sum ./lib/services/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/rimsky ./cmd/rimsky

FROM gcr.io/distroless/static-debian12:nonroot
LABEL org.opencontainers.image.title="rimsky-conformance"
LABEL org.opencontainers.image.description="Protocol conformance runners (executor, claim-producer, publisher, validation, data-processing, lifecycle-subscriber, host-daemon) plus the conformance probe, selected via 'rimsky conformance <protocol>'."
COPY --from=build /out/ /usr/local/bin/
USER nonroot:nonroot
