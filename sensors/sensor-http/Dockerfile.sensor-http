# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sensor-http ./sensors/sensor-http

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/sensor-http /usr/local/bin/sensor-http
USER nonroot
EXPOSE 9082
ENTRYPOINT ["/usr/local/bin/sensor-http"]
