/bin/
/tmp/
*.test
*.out
*.exe
vendor/
.idea/
.vscode/

# Compiled binaries (built ad-hoc at the repo-root module root)
/rimsky-supervisor
/rimsky-scheduler
/rimsky-control-api
/rimsky
/rimsky-migrate
/rimsky-entrypoint
/rimsky-host-agent
/rimsky-host-agent-proxy

# Test fixture binary — harness_test.go rebuilds it into a temp dir per run
/lib/runtime/hostagent/testdata/stubchild/stubchild

# Bundled-service node/TS build trees (lib/services/executors/claude-agent)
lib/services/executors/*/node_modules/
lib/services/executors/*/dist/

# Stray ad-hoc service binaries (built without -o at the lib/services
# module root, e.g. `cd lib/services && go build ./sensors/sensor-cron`
# leaves a binary at lib/services/sensor-cron). Anchored to lib/services/
# because that is the actual module root for these services.
lib/services/store-filesystem
lib/services/store-postgres
lib/services/sensor-cron
lib/services/sensor-http
lib/services/sensor-object-store
lib/services/sensor-webhook
lib/services/http-node
lib/services/verifier-http
lib/services/verifier-shape-checks
lib/services/openlineage
lib/services/stubexecutor

# Same stray-binary hazard at the REPO ROOT: building a service package by
# path from the root module (e.g. `go build ./lib/services/sensors/sensor-cron`)
# leaves the binary at ./<name>. Anchored to the repo root so it never shadows
# a same-named source directory deeper in the tree.
/sensor-cron
/sensor-http
/sensor-object-store
/sensor-webhook
/store-filesystem
/store-postgres
/http-node
/verifier-http
/verifier-shape-checks
/openlineage
/stubexecutor

# Same stray-binary hazard for the `examples/` module: building a package by
# path from the repo root (e.g. `go build ./examples/publisher`) or running
# `go build` inside an examples subdirectory leaves a binary named for the
# directory at the repo root. Anchored to the repo root so they never shadow
# a same-named source directory deeper in the tree.
/publisher
/claimproducer
/executor
/validation
/lifecyclesubscriber
/data-processing

# Stray test/example binaries left by ad-hoc `go build` inside the
# package directory: the example executor binary lands inside
# examples/executor/; the compose stub-executor testdata binary lands
# next to its source under cmd/rimsky/cli/compose/testdata/; the
# root-level stubchild is a stray from an out-of-tree build of the
# hostagent test fixture (whose in-tree path is already covered above).
/examples/executor/executor
/cmd/rimsky/cli/compose/testdata/stub-executor/stub-executor
/stubchild

# Same stray-binary hazard when running `go build ./...` (or `go vet ./...`
# with a build step) across the whole lib/services module: each main package
# gets its binary written into its own source directory, named for that
# directory, rather than at the lib/services module root.
lib/services/claim_producers/filesystem/cmd/cmd
lib/services/claim_producers/postgres/cmd/cmd
lib/services/executors/claude-agent/cmd/cmd
lib/services/executors/http-node/cmd/cmd
lib/services/executors/verifier-http/cmd/cmd
lib/services/executors/verifier-shape-checks/cmd/cmd
lib/services/sensors/sensor-cron/sensor-cron
lib/services/sensors/sensor-http/sensor-http
lib/services/sensors/sensor-object-store/sensor-object-store
lib/services/sensors/sensor-webhook/sensor-webhook
lib/services/subscribers/openlineage/openlineage
lib/services/test/overlapproducer/overlapproducer
lib/services/test/scenarios/claude_agent_fake_cli/fakeclaude/fakeclaude
lib/services/test/scenarios/claude_agent_fake_cli/fakeclaudeserver/fakeclaudeserver
lib/services/test/stubexecutor/stubexecutor

