{
  "name": "@rimsky-ai/protocols",
  "version": "0.15.0",
  "description": "Rimsky v1 wire-protocol .proto definitions for @grpc/proto-loader (and other protobuf toolchain) consumers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./proto/*": "./proto/*"
  },
  "files": [
    "proto/**/*.proto",
    "index.js",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rimsky",
    "grpc",
    "protobuf",
    "proto",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimsky-ai/rimsky-core.git",
    "directory": "lib/protocols"
  },
  "homepage": "https://github.com/rimsky-ai/rimsky-core/tree/main/lib/protocols"
}
