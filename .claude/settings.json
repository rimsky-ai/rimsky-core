{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(wc:*)",
      "Bash(touch:*)",
      "Bash(xargs:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(nvm:*)",
      "Bash(source:*)",
      "Bash(timeout:*)",
      "Bash(bash:*)",
      "Bash(./**/*.sh:*)",
      "Bash(NODE_OPTIONS=*)",
      "Bash(psql:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(docker:*)",
      "Bash(ping:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(python3:*)",
      "Bash(claude:*)",
      "Bash(aws:*)",
      "Bash(awslocal:*)",
      "Bash(./.aep-tool:*)",
      "Bash(sleep:*)",
      "Bash(which:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tr:*)",
      "Bash(date:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(xxd:*)",
      "Bash(tee:*)",
      "Bash(mktemp:*)",
      "Bash(xcrun devicectl list *)",
      "mcp__sp__get_round_details",
      "mcp__sp__get_past_results",
      "WebSearch",
      "WebFetch",
      "Skill(frontend-design)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.ok-planner/hooks/session-start\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ok-plumbline/hooks/post-edit.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ok-plumbline/hooks/pre-write.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ok-agent-model\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ok-plumbline/hooks/stop-review.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ok-plumbline/hooks/stop-review.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  }
}
