# syntax=docker/dockerfile:1.7
#
# Example rate-limit-once endpoint for the bundled park-then-resume recipe:
# the first request to any path answers 429 with a short Retry-After, and
# every retry answers 200. Driving the bundled http-node executor at it
# induces a real park (the executor's production 429 handling), a timed wake,
# and a resumed success — with nothing outside this checkout involved.
# Never published as a product image — the example ships only as source code
# (the Apache 2.0 permissive surface) for operators to copy-and-modify.
#
# Build context: the rimsky-core repo root, so the build sees go.work and the
# workspace modules — same shape as the other example images.
FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.work go.work.sum ./
COPY go.mod go.sum ./
COPY lib/foundation/go.mod lib/foundation/go.sum ./lib/foundation/
COPY lib/protocols/go.mod lib/protocols/go.sum ./lib/protocols/
COPY lib/services/go.mod lib/services/go.sum ./lib/services/
COPY examples/go.mod examples/go.sum ./examples/
RUN cd examples && go mod download
COPY . .
RUN cd examples && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/park-ratelimit ./park-resume

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/park-ratelimit /usr/local/bin/park-ratelimit
USER nonroot
EXPOSE 9420
ENTRYPOINT ["/usr/local/bin/park-ratelimit"]
