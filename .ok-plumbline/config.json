    { "tag": "@concept:",  "file_template": ".ok-planner/design/concepts/{slug}.md" },
    { "tag": "@story:",    "file_template": ".ok-planner/design/stories/{slug}.md" },
    { "tag": "@decision:", "file_template": ".ok-planner/design/decisions/{slug}.md" }
